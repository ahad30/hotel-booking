# Copy to server/.env and fill in. Never commit the real .env.

# MongoDB connection string used by Prisma
DATABASE_URL=

# Public URLs (with or without a trailing slash)
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
PORT=5000

# Auth: a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: phone number of a public demo admin that can browse but not change data
DEMO_ADMIN_PHONE=

# SSLCommerz (sandbox values work for testing)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Email (optional; needed for verification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
